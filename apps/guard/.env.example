# Copy this file to ".env" for development on your computer.
# ".env" is never committed and is NOT uploaded to EAS Build. For cloud
# builds, create the same EXPO_PUBLIC_* variables with "eas env:create"
# (see docs/01-installation.md, step 4.4).
#
# Variables starting with EXPO_PUBLIC_ are compiled INTO the app, so anyone
# with the app can read them. Only put public values here.
# NEVER put the Supabase service_role key in this file.

# Supabase -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://zdezuylsruzbddqcdhog.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-public-key-here

# Sentry -> Project (React Native) -> Client Keys (DSN). Optional.
EXPO_PUBLIC_SENTRY_DSN=

# Phone number offered on the SOS screen when there is no data connection.
EXPO_PUBLIC_CONTROL_ROOM_PHONE=+968XXXXXXXX
